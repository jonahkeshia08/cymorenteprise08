NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Admin
ADMIN_API_KEY=change-this-long-random-secret

# Firebase Admin SDK
FIREBASE_PROJECT_ID=cymor-shoe-store
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# WhatsApp bot
WHATSAPP_SESSION_PATH=.wwebjs_auth
BOT_ENABLED=true
STORE_PHONE=254700000000
STORE_NAME=Cymor Shoe Store

# Daraja M-Pesa
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=your-consumer-key
DARAJA_CONSUMER_SECRET=your-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your-passkey
DARAJA_CALLBACK_URL=https://your-render-app.onrender.com/api/mpesa/callback
DARAJA_ACCOUNT_REFERENCE=CYMOR
DARAJA_TRANSACTION_DESC=Cymor Shoe Store Order
